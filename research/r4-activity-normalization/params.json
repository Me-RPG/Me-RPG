  "load_formulas": {
    "canonical_unit": "TL (Banister-TRIMP-equivalent arbitrary units). Every path yields an intensity fraction x in [0,1] (about %HRR / %VO2R) and a duration D in minutes.",
    "trimp_core": {
      "formula": "TL = D_min * x * a * exp(b * x)",
      "coefficients": {"male": {"a": 0.64, "b": 1.92}, "female": {"a": 0.86, "b": 1.67}, "unspecified": {"a": 0.64, "b": 1.92, "note": "default to the male coefficients (Banister's original); the female curve gives about 10-15% more load for mid-range x"}},
      "source": "Banister 1991; Morton, Fitz-Clarke & Banister 1990"
    },
    "intensity_from_hr": {
      "formula": "x = (HR_avg - HR_rest) / (HR_max - HR_rest), clamp [0,1]",
      "defaults": {"HR_max": "208 - 0.7 * age (Tanaka 2001)", "HR_rest": 65},
      "valid_when": "type.hr_valid == true and HR sampled for at least 50% of session",
      "caveat": "Average HR under-counts interval sessions because exp() is convex. Prefer per-sample integration (sum over samples of dt * x_i * a * exp(b*x_i)) when HR samples are available (HealthKit/Health Connect HeartRateRecord, Strava streams)."
    },
    "edwards_trimp": {
      "formula": "TL_edwards = sum_z (minutes_in_zone_z * w_z)",
      "zones_pct_hrmax": [[50, 60, 1], [60, 70, 2], [70, 80, 3], [80, 90, 4], [90, 100, 5]],
      "use": "optional cross-check when HR zone durations are available; not the canonical unit"
    },
    "lucia_trimp": {
      "formula": "TL_lucia = min_below_VT1 * 1 + min_VT1_to_VT2 * 2 + min_above_VT2 * 3",
      "use": "only if ventilatory thresholds are known; not used by default"
    },
    "intensity_from_rpe": {
      "formula": "x = min(1, 0.2 + 0.1 * RPE_cr10) for RPE_cr10 >= 1; x = 0 for RPE 0",
      "scale": "Foster modified CR-10 (0 rest, 1 very very easy, 2 easy, 3 moderate, 4 somewhat hard, 5 hard, 7 very hard, 10 maximal), asked about 30 min after the session",
      "calibration_anchors": "ACSM (Garber 2011): moderate = 40-59% HRR ~ RPE 12-13 (CR-10 ~3-4); vigorous = 60-89% HRR ~ RPE 14-17 (CR-10 ~5-7)",
      "confidence": "low-moderate; this mapping is a HealthRPG design choice, not a published equation"
    },
    "session_rpe_raw": {
      "formula": "sRPE_AU = RPE_cr10 * D_min",
      "source": "Foster et al. 2001",
      "use": "store alongside TL for analytics; sRPE is the most valid internal-load measure for resistance and intermittent training"
    },
    "intensity_from_met": {
      "formula": "x = (MET_eff - 1) / (MET_max - 1), clamp [0.05, 1]",
      "defaults": {"MET_max": 10.0, "MET_max_note": "10 MET ~ VO2max 35 ml/kg/min (typical untrained adult). Personalize from HealthKit VO2Max / Health Connect Vo2MaxRecord: MET_max = VO2max / 3.5"},
      "basis": "%VO2R ~ %HRR (Swain & Leutholtz 1997; ACSM)"
    },
    "grade_adjustment": {
      "walk": {"formula": "MET_eff = MET_level + k * elevation_gain_m / D_min", "k": 0.514, "derivation": "ACSM walking vertical term 1.8 * S * G ml/kg/min, integrated over the session = 1.8 ml/kg per metre climbed; / 3.5 = 0.514 MET-min per metre"},
      "walk_loaded": {"formula": "same as walk, then multiply by Pandolf load factor if pack mass known: f = M_pandolf(W,L,V,G,eta) / M_pandolf(W,0,V,G,eta)", "k": 0.514, "pandolf": "M_watts = 1.5*W + 2.0*(W+L)*(L/W)^2 + eta*(W+L)*(1.5*V^2 + 0.35*V*G)", "eta_terrain": {"treadmill_or_paved": 1.0, "dirt_road": 1.1, "light_brush": 1.2, "hard_snow": 1.3, "heavy_brush": 1.5, "swampy_bog": 1.8, "loose_sand": 2.1}},
      "run": {"formula": "MET_eff = MET_level + k * elevation_gain_m / D_min", "k": 0.257, "derivation": "ACSM running vertical term 0.9 * S * G ml/kg/min -> 0.9 ml/kg per metre / 3.5"},
      "cycle": {"formula": "MET_eff = MET_speed + k * elevation_gain_m / D_min", "k": 0.25, "confidence": "low; half-weighted because the speed-based MET already falls on climbs. Validate with power data."},
      "noise_floor": "ignore elevation_gain below 10 m per km (GPS/baro noise); cap MET_eff at 1.25 * type.met.high",
      "descents": "ignored (the ACSM equations do not credit or charge descent; Minetti 2002 shows descent is cheaper than level walking down to about -10% grade)"
    },
    "duration_rules": {
      "source_priority": ["moving_time", "active duration", "elapsed_time"],
      "cap_minutes_per_session": 360,
      "min_minutes": 3
    }
  },
  "fallback_rules": {
    "intensity_priority": [
      "1. HR samples (per-sample Banister), if type.hr_valid and coverage >= 50%",
      "2. average HR (Banister on avg), if type.hr_valid",
      "3. user-entered RPE (CR-10)",
      "4. power (stationary bike / rowing tables or ACSM cycling equation)",
      "5. speed from distance/moving_time -> speed_met_tables, plus grade_adjustment",
      "6. type default: if intensity_basis == 'rpe_default' use default_rpe_cr10; else use met.mid",
      "7. unknown type -> other_workout defaults"
    ],
    "intensity_hint_override": {"low": "met.low or default_rpe - 2", "high": "met.high or default_rpe + 2"},
    "unknown_type_default": {"id": "other_workout", "met_mid": 5.0, "default_rpe_cr10": 4},
    "type_only_example": "60 min 'hike', no other data: MET 5.3 -> x = 4.3/9 = 0.478 -> TL = 60 * 0.478 * 0.64 * exp(1.92*0.478) = ~46 TL",
    "confidence_tag": {"hr_samples": "high", "hr_avg": "medium", "rpe": "medium", "power": "medium", "speed_grade": "medium", "type_only": "low"},
    "anti_abuse": {"max_tl_per_session": 600, "max_sessions_per_day_counted": 6, "flag_if_walk_speed_mph_gt": 6.0, "flag_if_run_speed_mph_gt": 15.0}
  },
  "capacity_modifiers": {
    "_note": "Applied after the base split, then renormalized to sum 1.0. LOW confidence design heuristics.",
    "grade": "For walk/hike/hike_loaded/run/trail_run/snowshoe: g = elevation_gain_m / distance_m. Move min(0.15, 1.5*g) from aerobic to muscular_endurance.",
    "pack_load": "hike_loaded with known pack mass L and body mass W: move min(0.10, 0.5*L/W) from aerobic to muscular_strength.",
    "resistance_rpe": "resistance_training with RPE >= 8: move 0.05 from muscular_endurance to muscular_strength. RPE <= 4: move 0.10 from muscular_strength to muscular_endurance.",
    "long_duration": "Any type with D > 90 min: move 0.05 from muscular_strength to muscular_endurance (if available)."
  }
}
