    "onset_m": { "low": 300, "mid": 700, "high": 1500, "sources": ["[19] decline already 300->800 m", "[20] Fulco 1998: from ~580 m", "high = common heuristic"] },
    "use_altitude": "max_alt_m of route (conservative) or time-weighted mean altitude",
    "performance_time_to_exhaustion_loss_per_1000m": { "low": null, "mid": 0.145, "high": null, "sources": ["[19]"] },
