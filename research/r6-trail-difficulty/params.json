{
  "version": "0.1.0-unreviewed",
  "notes": "Uncertain numbers are {low, mid, high, sources}. Source keys refer to the citation list in report.md. 'design' means HealthRPG heuristic, not a published value.",
  "units": { "distance": "m or km as named", "elevation": "m", "speed": "km/h", "vo2": "mL/kg/min", "energy": "J/kg (net)", "load": "MET-min (gross)" },

  "formulas": {
    "shenandoah": {
      "expr_imperial": "S = sqrt(2 * gain_ft * distance_mi)",
      "expr_metric": "S = k * sqrt(gain_m * dist_km)",
      "coefficients": { "k": 2.0192, "ft_per_m": 3.28084, "mi_per_km": 0.621371 },
      "confidence": "high",
      "sources": ["[1] NPS Shenandoah"]
    },
    "naismith": {
      "expr": "t_h = dist_km / flat_kmh + gain_m / ascent_m_per_h",
      "coefficients": { "flat_kmh": 5.0, "ascent_m_per_h": 600 },
      "confidence": "high",
      "sources": ["[2] Wikipedia Naismith's rule"]
    },
    "scarf_equivalence": {
      "expr": "equiv_km = dist_km + alpha * gain_km; t_h = equiv_km / 5",
      "coefficients": { "alpha": { "low": 7.92, "mid": 8.0, "high": 10.0, "sources": ["[3] Scarf 2007: 7.92 derived; 8 men, 10 women recommended"] } },
      "confidence": "high"
    },
    "aitken": {
      "expr": "path: 1 h / 3 mi; other terrain: 1 h / 2.5 mi; plus 1 h / 2000 ft ascent",
      "coefficients": { "rough_terrain_speed_factor": 0.833 },
      "confidence": "medium",
      "sources": ["[2]"]
    },
    "langmuir": {
      "expr": "t_h = dist_km/5 + gain_m/600 - (loss_gentle_m/300)*(10/60) + (loss_steep_m/300)*(10/60)",
      "coefficients": {
        "gentle_descent_deg": [5, 12],
        "steep_descent_deg_gt": 12,
        "minutes_per_300m_descent": 10,
        "group_flat_kmh": 4.0,
        "group_ascent_m_per_h": 450
      },
      "confidence": "medium",
      "sources": ["[2] citing Langmuir 1984 Mountaincraft and Leadership"]
    },
    "tranter": {
      "expr": "corrected_h = table[fitness_minutes][naismith_h]; fitness_minutes = time to climb 300 m over 800 m",
      "table": {
        "columns_naismith_h": [2, 3, 4, 5, 6, 7, 8, 9, 10, 12, 14, 16, 18, 20, 22, 24],
        "15": [1, 1.5, 2, 2.75, 3.5, 4.5, 5.5, 6.75, 7.75, 10, 12.5, 14.5, 17, 19.5, 22, 24],
        "20": [1.25, 2.25, 3.25, 4.5, 5.5, 6.7, 7.75, 8.75, 10, 12.5, 15, 17.5, 20, 23, null, null],
        "25": [1.5, 3, 4.25, 5.5, 7, 8.5, 10, 11.5, 13.25, 15, 17.5, null, null, null, null, null],
        "30": [2, 3.5, 5, 6.75, 8.5, 10.5, 12.5, 14.5, null, null, null, null, null, null, null, null],
        "40": [2.75, 4.25, 5.75, 7.5, 9.5, 11.5, null, null, null, null, null, null, null, null, null, null],
        "50": [3.25, 4.75, 6.5, 8.5, null, null, null, null, null, null, null, null, null, null, null, null]
      },
      "null_means": "beyond capacity for that fitness level (usable as a gate)",
      "confidence": "medium",
      "sources": ["[2]", "[4] secondary transcription; primary not accessed"]
    },
    "tobler": {
      "expr": "v_kmh = a * exp(-b * abs(s + c)); s = dh/dx",
      "coefficients": { "a": 6.0, "b": 3.5, "c": 0.05, "off_path_factor": 0.6, "horseback_factor": 1.25 },
      "confidence": "high",
      "sources": ["[5] Tobler 1993 via Wikipedia", "[6][7] validation/critique"]
    },
    "minetti_cw": {
      "expr": "Cw(i) = c5*i^5 + c4*i^4 + c3*i^3 + c2*i^2 + c1*i + c0  [J/kg/m, net of resting]",
      "coefficients": { "c5": 280.5, "c4": -58.7, "c3": -76.8, "c2": 51.9, "c1": 19.6, "c0": 2.5 },
      "valid_gradient_range": [-0.45, 0.45],
      "r2": 0.999,
      "energy_equivalent_J_per_mL_O2": 20.9,
      "eccentric_threshold_gradient": -0.15,
      "confidence": "high",
      "sources": ["[8] Minetti et al. 2002, read from PDF"]
    },
    "minetti_cr_running": {
      "expr": "Cr(i) = 155.4 i^5 - 30.4 i^4 - 43.3 i^3 + 46.3 i^2 + 19.5 i + 3.6",
      "coefficients": { "c5": 155.4, "c4": -30.4, "c3": -43.3, "c2": 46.3, "c1": 19.5, "c0": 3.6 },
      "confidence": "high",
      "sources": ["[8]"]
    },
    "pandolf": {
      "expr": "M_W = 1.5*W + 2.0*(W+L)*(L/W)^2 + eta*(W+L)*(1.5*V^2 + 0.35*V*G)  [G in %, V in m/s]",
      "santee_downhill_expr": "CF = eta*((G*(W+L)*V)/3.5 - ((W+L)*(G+6)^2)/W + (25 - V^2)); M = M - CF for G<0",
      "terrain_eta": { "blacktop": 1.0, "dirt_road": 1.1, "light_brush": 1.2, "heavy_brush": 1.5, "swampy_bog": 1.8, "loose_sand": 2.1, "snow_15cm": 2.5, "snow_25cm": 3.3, "snow_35cm": 4.1 },
      "confidence": "medium (Santee term: low, unverified)",
      "sources": ["[9]"]
    },
    "acsm_walking": {
      "expr": "VO2 = 3.5 + 0.1*S + 1.8*S*G  [S m/min, G fraction]; not valid downhill",
      "coefficients": { "rest": 3.5, "horizontal": 0.1, "vertical": 1.8, "valid_speed_m_per_min": [50, 100] },
      "confidence": "high",
      "sources": ["[10]"]
    },
    "met_conversion": {
      "expr": "net_MET_min = (net_J_per_kg / 20.9) / 3.5; gross_MET_min = net_MET_min + duration_min",
      "coefficients": { "mL_O2_per_kg_min_per_MET": 3.5, "J_per_mL_O2": 20.9 },
      "avg_MET_clamp": { "low": 3.3, "mid": null, "high": 9.0, "sources": ["[12] Compendium 17180 walking downhill 3.3; 17036 hill climbing 8.8; design clamp"] },
      "compendium_reference_METs": { "17080_hiking_cross_country": 6.0, "17081_hiking_slow": 3.8, "17082_hiking_normal": 5.3, "17010_backpacking": 7.0, "17012_daypack": 7.8, "17180_walk_downhill_2_5mph": 3.3, "17036_hills_11_20pct": 8.8, "17039_hills_30_40pct": 15.5 },
      "confidence": "high (conversion); low (clamp)",
      "sources": ["[8]", "[11]", "[12]"]
    }
  },

