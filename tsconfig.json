{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@me-rpg/engine": [
        "packages/engine/src/index.ts"
      ],
      "@me-rpg/fitness-model": [
        "packages/fitness-model/src/index.ts"
      ],
      "@me-rpg/content": [
        "packages/content/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "apps/*/src"
  ],
  "exclude": [
    "apps/mobile"
  ]
}
